# Read-only multimarketplace quality evaluation; remains disabled by default.
# false=V1 atual; shadow=observação; active=admissão V2 (somente após aprovação)
OFFER_QUALITY_PIPELINE_V2=false

# Trend-driven discovery. `off` preserves the current Oracle scenario authority.
# `shadow` is observational only; `active` is intentionally blocked until explicit future approval.
TREND_EXECUTIVE_MODE=off