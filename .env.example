# Telegram Bot API - server-side only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@caca_ofertaoficial

# WhatsApp Engine (Oracle)
# ORACLE_REMOTE_URL: URL pública/privada alcançável pela Vercel para a API Oracle (sem /api final)
ORACLE_REMOTE_URL=
# ORACLE_API_KEY: mesma chave configurada na API Oracle; server-side only
ORACLE_API_KEY=
# WHATSAPP_ENGINE_URL: URL do motor Baileys rodando na Oracle (ex.: https://seu-tunel.ngrok-free.app)
WHATSAPP_ENGINE_URL=
# WHATSAPP_ENGINE_API_KEY: chave de autenticação do motor (deve bater com o valor no motor)
WHATSAPP_ENGINE_API_KEY=
# WHATSAPP_TARGET_ID: JID do destino operacional principal.
# Padrão oficial: Grupo WhatsApp (@g.us).
# Canal WhatsApp (@newsletter) permanece apenas para compatibilidade/legado.
# Exemplo grupo oficial: 120363427692723224@g.us
# Exemplo canal legado:  120363426476830692@newsletter
WHATSAPP_TARGET_ID=
# Fallbacks legados (mantidos para retrocompatibilidade; não usar como configuração principal)
WHATSAPP_CHANNEL_ID=
WHATSAPP_DEFAULT_CHANNEL_ID=
# Mantém os links do grupo curtos; deixe true somente se for necessário
# forçar uma nova prévia de mídia no WhatsApp a cada envio.
WHATSAPP_CACHE_BUSTER=false

# Groq AI settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cerebras is an optional official provider. Keep the key server-side only.
CEREBRAS_API_KEY=

