# Public app metadata
NEXT_PUBLIC_APP_NAME=Caça Oferta Oficial
NEXT_PUBLIC_INSTAGRAM_USERNAME=caca.ofertaoficial
NEXT_PUBLIC_TELEGRAM_NAME=Caça Oferta Oficial
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/caca_ofertaoficial

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Leave empty unless a future server-only feature strictly needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot API - server-side only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@caca_ofertaoficial

# WhatsApp Engine (Oracle)
# WHATSAPP_ENGINE_URL: URL do motor Baileys rodando na Oracle (ex.: https://seu-tunel.ngrok-free.app)
WHATSAPP_ENGINE_URL=
# WHATSAPP_ENGINE_API_KEY: chave de autenticação do motor (deve bater com o valor no motor)
WHATSAPP_ENGINE_API_KEY=
# WHATSAPP_TARGET_ID: JID do destino operacional principal.
# Padrão oficial: Grupo WhatsApp (@g.us).
# Canal WhatsApp (@newsletter) permanece apenas para compatibilidade/legado.
# Exemplo grupo oficial: 120363427692723224@g.us
# Exemplo canal legado:  120363426476830692@newsletter
WHATSAPP_TARGET_ID=
# Fallbacks legados (mantidos para retrocompatibilidade; não usar como configuração principal)
WHATSAPP_CHANNEL_ID=
WHATSAPP_DEFAULT_CHANNEL_ID=

# Groq AI settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Integrações de marketplace
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br
MAGALU_PARTNER_ID=
MERCADO_LIVRE_CLIENT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Instagram Business Account ID (Optional, discovered dynamically if empty)
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook Pages API
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# Rakuten / Netshoes
RAKUTEN_AFFILIATE_ID=
RAKUTEN_NETSHOES_MID=
