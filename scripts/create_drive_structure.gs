  "app/workers/publisher_worker.py": "\"\"\"Worker de publicação.\"\"\"\n\nfrom datetime import datetime\n\nfrom sqlalchemy.orm import Session\n\nfrom app.channels.telegram import TelegramPublisher\nfrom app.core.models import AffiliateLink, Channel, OfferStatus, Post, Product\nfrom app.services.link_service import add_tracking_param, make_sub_id\nfrom app.services.text_generator import generate_message\n\n\ndef publish_next_offer_to_telegram(session: Session) -> dict:\n    product = (\n        session.query(Product)\n        .filter(Product.status == OfferStatus.approved)\n        .order_by(Product.score.desc().nullslast(), Product.created_at.asc())\n        .first()\n    )\n\n    if not product:\n        return {\"ok\": False, \"reason\": \"Nenhuma oferta aprovada.\"}\n\n    sub_id = make_sub_id(product, Channel.telegram)\n    tracked_url = add_tracking_param(product.original_url, sub_id)\n\n    affiliate_link = AffiliateLink(\n        product_id=product.id,\n        channel=Channel.telegram,\n        url=tracked_url,\n        sub_id=sub_id,\n    )\n    session.add(affiliate_link)\n    session.flush()\n\n    message = generate_message(product, Channel.telegram, tracked_url)\n\n    publisher = TelegramPublisher()\n    result = publisher.send_message(message)\n\n    post = Post(\n        product_id=product.id,\n        affiliate_link_id=affiliate_link.id,\n        channel=Channel.telegram,\n        message=message,\n        external_id=str(result.get(\"result\", {}).get(\"message_id\")),\n        posted=True,\n        posted_at=datetime.utcnow(),\n    )\n\n    product.status = OfferStatus.posted\n    session.add(post)\n    session.commit()\n\n    return {\"ok\": True, \"product\": product.name, \"telegram_result\": result}\n",
