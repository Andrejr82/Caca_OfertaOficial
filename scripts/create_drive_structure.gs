  Object.keys(files).forEach(function(relativePath) {
    const parts = relativePath.split("/");
    const fileName = parts.pop();
    let current = projectFolder;

    parts.forEach(function(folderName) {
      current = getOrCreateFolder(current, folderName);
    });

    createOrReplaceFile(current, fileName, files[relativePath]);
  });

  Logger.log("Estrutura completa criada em: " + projectFolder.getUrl());
}

function getOrCreateFolder(parent, name) {
  const existing = parent.getFoldersByName(name);
  if (existing.hasNext()) {
    return existing.next();
  }
  return parent.createFolder(name);
}

function createOrReplaceFile(folder, name, content) {
  const files = folder.getFilesByName(name);
  while (files.hasNext()) {
    files.next().setTrashed(true);
  }
  folder.createFile(name, content, MimeType.PLAIN_TEXT);
}
