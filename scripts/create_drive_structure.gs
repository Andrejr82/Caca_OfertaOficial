  "app/affiliates/shopee.py": "\"\"\"Integração Shopee Afiliados.\n\nA implementação real depende da aprovação no programa e da liberação da Open API.\nEnquanto isso, o método convert_url retorna o link original com sub_id.\n\"\"\"\n\nfrom app.services.link_service import add_tracking_param\n\n\nclass ShopeeAffiliateClient:\n    def convert_url(self, product_url: str, sub_id: str) -> str:\n        return add_tracking_param(product_url, sub_id)\n\n    def search_promotions(self, keyword: str) -> list[dict]:\n        return []\n",
  "app/affiliates/amazon.py": "\"\"\"Integração Amazon Associados.\"\"\"\n\nfrom app.services.link_service import add_tracking_param\n\n\nclass AmazonAffiliateClient:\n    def __init__(self, associate_tag: str | None = None) -> None:\n        self.associate_tag = associate_tag\n\n    def make_link(self, asin: str, sub_id: str) -> str:\n        base = f\"https://www.amazon.com.br/dp/{asin}\"\n        if self.associate_tag:\n            base = f\"{base}?tag={self.associate_tag}\"\n        return add_tracking_param(base, sub_id)\n",
  "app/affiliates/magalu.py": "\"\"\"Integração Parceiro Magalu.\"\"\"\n\n\nclass MagaluAffiliateClient:\n    def convert_url(self, product_url: str, sub_id: str) -> str:\n        separator = \"&\" if \"?\" in product_url else \"?\"\n        return f\"{product_url}{separator}sub_id={sub_id}\"\n",
  "app/affiliates/mercadolivre.py": "\"\"\"Integração Mercado Livre Afiliados.\"\"\"\n\n\nclass MercadoLivreAffiliateClient:\n    def convert_url(self, product_url: str, sub_id: str) -> str:\n        separator = \"&\" if \"?\" in product_url else \"?\"\n        return f\"{product_url}{separator}sub_id={sub_id}\"\n",
