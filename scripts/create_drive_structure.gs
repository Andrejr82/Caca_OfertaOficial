  "app/api/server.py": "\"\"\"API FastAPI para o Caça Oferta Oficial.\"\"\"\n\nfrom fastapi import FastAPI\nfrom sqlalchemy.orm import Session\n\nfrom app.core.database import SessionLocal, create_tables\nfrom app.core.models import Product\nfrom app.services.ranking_service import score_product\n\napp = FastAPI(title=\"Caça Oferta Oficial API\", version=\"0.1.0\")\n\n\n@app.on_event(\"startup\")\ndef startup() -> None:\n    create_tables()\n\n\n@app.get(\"/health\")\ndef health() -> dict:\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/offers\")\ndef create_offer(payload: dict) -> dict:\n    with SessionLocal() as session:\n        product = Product(**payload)\n        product.score = score_product(product)\n        session.add(product)\n        session.commit()\n        session.refresh(product)\n        return {\"id\": product.id, \"score\": product.score}\n\n\n@app.get(\"/offers\")\ndef list_offers() -> list[dict]:\n    with SessionLocal() as session:\n        products = session.query(Product).order_by(Product.created_at.desc()).limit(50).all()\n        return [\n            {\n                \"id\": p.id,\n                \"platform\": p.platform,\n                \"name\": p.name,\n                \"category\": p.category,\n                \"price\": p.price,\n                \"score\": p.score,\n                \"status\": p.status.value,\n            }\n            for p in products\n        ]\n",
  "app/api/__init__.py": "\"\"\"Package.\"\"\"\n",
  "app/dashboard/streamlit_app.py": "\"\"\"Painel administrativo inicial em Streamlit.\"\"\"\n\nimport streamlit as st\nimport pandas as pd\n\nfrom app.core.database import SessionLocal, create_tables\nfrom app.core.models import Channel, Product\nfrom app.services.ranking_service import score_product\nfrom app.services.link_service import add_tracking_param, make_sub_id\nfrom app.services.text_generator import generate_message, generate_carousel_text, generate_reels_script\n\ncreate_tables()\n\nst.set_page_config(page_title=\"Caça Oferta Oficial\", layout=\"wide\")\nst.title(\"🔥 Caça Oferta Oficial\")\n\ntab1, tab2 = st.tabs([\"Cadastrar oferta\", \"Mensagens\"])\n\nwith tab1:\n    with st.form(\"offer_form\"):\n        platform = st.selectbox(\"Plataforma\", [\"Shopee\", \"Amazon\", \"Magalu\", \"Mercado Livre\"])\n        name = st.text_input(\"Produto\")\n        category = st.text_input(\"Categoria\")\n        original_url = st.text_input(\"Link original\")\n        price = st.number_input(\"Preço\", min_value=0.0, step=1.0)\n        old_price = st.number_input(\"Preço anterior\", min_value=0.0, step=1.0)\n        coupon = st.text_input(\"Cupom\")\n        submitted = st.form_submit_button(\"Salvar oferta\")\n\n    if submitted:\n        with SessionLocal() as session:\n            p = Product(\n                platform=platform,\n                name=name,\n                category=category,\n                original_url=original_url,\n                price=price,\n                old_price=old_price or None,\n                coupon=coupon or None,\n            )\n            p.score = score_product(p)\n            session.add(p)\n            session.commit()\n            st.success(f\"Oferta salva com score {p.score}\")\n\nwith tab2:\n    with SessionLocal() as session:\n        products = session.query(Product).order_by(Product.created_at.desc()).limit(20).all()\n        if not products:\n            st.info(\"Cadastre uma oferta primeiro.\")\n        else:\n            product = st.selectbox(\"Escolha uma oferta\", products, format_func=lambda p: f\"{p.name} - {p.platform}\")\n            channel = st.selectbox(\"Canal\", [Channel.telegram, Channel.instagram, Channel.whatsapp], format_func=lambda c: c.value)\n            sub_id = make_sub_id(product, channel)\n            url = add_tracking_param(product.original_url, sub_id)\n            message = generate_message(product, channel, url)\n\n            st.subheader(\"Mensagem\")\n            st.code(message, language=\"text\")\n\n            if channel == Channel.instagram:\n                st.subheader(\"Roteiro Reels\")\n                st.code(generate_reels_script(product), language=\"text\")\n                st.subheader(\"Carrossel\")\n                st.write(pd.DataFrame({\"Slide\": generate_carousel_text(product)}))\n",
