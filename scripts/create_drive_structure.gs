  const projectFolder = getOrCreateFolder(root, "caca_oferta");

  const files = {
  "README.md": "# Caça Oferta Oficial\n\nSistema fullstack para automatizar divulgação de ofertas de afiliados no Telegram, Instagram e WhatsApp.\n\n## Objetivo\n\nO projeto Caça Oferta Oficial automatiza este fluxo:\n\n1. Receber ou buscar produtos em promoção.\n2. Avaliar se a oferta é boa.\n3. Gerar link de afiliado com rastreamento por canal.\n4. Gerar textos para Telegram, Instagram e WhatsApp.\n5. Publicar automaticamente no Telegram.\n6. Gerar conteúdo semiautomático para Instagram.\n7. Gerar mensagem pronta para WhatsApp.\n8. Registrar cliques, vendas e comissões.\n\n## Canais\n\n- Telegram: Caça Oferta Oficial (https://t.me/caca_ofertaoficial).\n- Instagram: caca.ofertaoficial.\n- WhatsApp: semiautomático no MVP, automático via Cloud API no futuro.\n\n## Stack sugerida\n\n- Python 3.11+\n- FastAPI\n- SQLite no MVP\n- PostgreSQL em produção\n- SQLAlchemy\n- APScheduler\n- python-telegram-bot ou requests\n- Streamlit para painel administrativo inicial\n- Vercel/Render/Railway para deploy futuro\n- Meta APIs para Instagram e WhatsApp\n\n## Instalação\n\n```bash\npython -m venv .venv\nsource .venv/bin/activate  # Linux/Mac\n# Windows:\n# .venv\\Scripts\\activate\n\npip install -r requirements.txt\ncp .env.example .env\npython main.py --init-db\npython main.py --seed\npython main.py --run-once\n```\n\n## Estrutura\n\n```text\ncaca_oferta/\n├── app/\n│   ├── affiliates/\n│   ├── channels/\n│   ├── core/\n│   ├── dashboard/\n│   ├── services/\n│   ├── api/\n│   └── workers/\n├── docs/\n├── scripts/\n├── tests/\n├── main.py\n├── requirements.txt\n├── .env.example\n└── README.md\n```\n\n## MVP\n\nNo primeiro MVP, a automação real será:\n\n- cadastro manual de oferta;\n- geração automática dos textos;\n- publicação automática no Telegram;\n- mensagem pronta para copiar no WhatsApp;\n- legenda e roteiro prontos para Instagram;\n- controle em banco de dados local;\n- painel administrativo simples.\n\n## Próximas fases\n\n1. Conectar API da Shopee.\n2. Conectar Amazon, Magalu e Mercado Livre.\n3. Criar encurtador/rastreador próprio.\n4. Automatizar Instagram via API oficial.\n5. Automatizar WhatsApp via Cloud API oficial.\n",
  "requirements.txt": "fastapi>=0.111.0\nuvicorn>=0.30.0\nrequests>=2.32.0\npython-dotenv>=1.0.1\nSQLAlchemy>=2.0.30\nAPScheduler>=3.10.4\npydantic>=2.7.0\nstreamlit>=1.35.0\npandas>=2.2.2\npython-multipart>=0.0.9\npytest>=8.2.0\n",
  ".env.example": "# Ambiente\nENVIRONMENT=development\nDATABASE_URL=sqlite:///./data/caca_oferta.sqlite3\n\n# Marca\nBRAND_NAME=Caça Oferta Oficial\nDEFAULT_AFFILIATE_DISCLOSURE=Alguns links podem gerar comissão para o Caça Oferta Oficial, sem custo adicional para você.\n\n# Telegram\nTELEGRAM_BOT_TOKEN=\nTELEGRAM_CHANNEL_ID=@caca_ofertaoficial\nTELEGRAM_CHANNEL_NAME=Caça Oferta Oficial\nTELEGRAM_CHANNEL_URL=https://t.me/caca_ofertaoficial\n\n# Instagram Graph API - futuro\nINSTAGRAM_USERNAME=caca.ofertaoficial\nMETA_APP_ID=\nMETA_APP_SECRET=\nINSTAGRAM_ACCESS_TOKEN=\nINSTAGRAM_BUSINESS_ACCOUNT_ID=\n\n# WhatsApp Cloud API - futuro\nWHATSAPP_TOKEN=\nWHATSAPP_PHONE_NUMBER_ID=\nWHATSAPP_BUSINESS_ACCOUNT_ID=\n\n# Shopee Afiliados - futuro\nSHOPEE_APP_ID=\nSHOPEE_APP_SECRET=\nSHOPEE_AFFILIATE_ID=\n\n# Amazon Associados - futuro\nAMAZON_ACCESS_KEY=\nAMAZON_SECRET_KEY=\nAMAZON_ASSOCIATE_TAG=\n",
  ".gitignore": ".env\n.venv/\n__pycache__/\n*.pyc\ndata/*.sqlite3\ndata/*.db\n.DS_Store\ndist/\nbuild/\n*.zip\n",
  "main.py": "\"\"\"CLI principal do Caça Oferta Oficial.\"\"\"\n\nimport argparse\nimport logging\n\nfrom app.core.config import settings\nfrom app.core.database import create_tables, SessionLocal\nfrom app.services.seed_service import seed_demo_data\nfrom app.workers.publisher_worker import publish_next_offer_to_telegram\n\n\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(message)s\")\n\n\ndef parse_args() -> argparse.Namespace:\n    parser = argparse.ArgumentParser(description=\"Caça Oferta Oficial\")\n    parser.add_argument(\"--init-db\", action=\"store_true\", help=\"Cria tabelas do banco de dados\")\n    parser.add_argument(\"--seed\", action=\"store_true\", help=\"Insere dados de exemplo\")\n    parser.add_argument(\"--run-once\", action=\"store_true\", help=\"Executa uma publicação de teste\")\n    return parser.parse_args()\n\n\ndef main() -> None:\n    args = parse_args()\n\n    if args.init_db:\n        create_tables()\n        logging.info(\"Banco inicializado.\")\n\n    if args.seed:\n        with SessionLocal() as session:\n            seed_demo_data(session)\n        logging.info(\"Dados de demonstração inseridos.\")\n\n    if args.run_once:\n        with SessionLocal() as session:\n            result = publish_next_offer_to_telegram(session)\n        logging.info(\"Resultado: %s\", result)\n\n    if not any(vars(args).values()):\n        print(f\"{settings.brand_name} pronto. Use --help para ver os comandos.\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
  "app/__init__.py": "\"\"\"Pacote principal do Caça Oferta Oficial.\"\"\"\n",
  "docs/ARQUITETURA.md": "# Arquitetura\n\n## Módulos\n\n- Core: configurações, banco e modelos.\n- Services: geração de texto, ranking e links.\n- Affiliates: integrações com programas de afiliados.\n- Channels: publicação nos canais.\n- Workers: rotinas automáticas.\n- Dashboard: interface inicial em Streamlit.\n- API: endpoints FastAPI.\n\n## Banco de dados\n\nO MVP usa SQLite. Em produção, migrar para PostgreSQL.\n\n## Segurança\n\n- Nunca versionar `.env`.\n- Usar tokens com menor permissão possível.\n- Rotacionar tokens periodicamente.\n- Separar credenciais por ambiente.\n",
  "docs/ROADMAP.md": "# Roadmap\n\n## Fase 1\n- Canais criados.\n- Cadastro em Shopee Afiliados.\n- Cadastro manual de ofertas.\n- Geração de mensagens.\n- Telegram automático.\n\n## Fase 2\n- Dashboard Streamlit.\n- Conteúdo para Instagram.\n- Mensagem pronta para WhatsApp.\n- Controle de posts.\n\n## Fase 3\n- Solicitar API Shopee.\n- Buscar produtos automaticamente.\n- Gerar links automaticamente.\n- Registrar cliques.\n\n## Fase 4\n- Instagram Graph API.\n- WhatsApp Cloud API.\n- Dashboard financeiro.\n",
  "docs/COMPLIANCE.md": "# Compliance\n\n## Transparência\n\nSempre informar que links podem gerar comissão.\n\n## WhatsApp\n\nNão fazer spam.\nEnviar mensagens apenas para pessoas que aceitaram receber.\nUsar Cloud API oficial em automações futuras.\n\n## Instagram\n\nUsar conta profissional.\nNão usar automação de login ou bots de engajamento.\nUsar Graph API oficial quando autorizado.\n\n## Telegram\n\nUsar Bot API oficial.\nEvitar excesso de postagens e conteúdo enganoso.\n",
  "docs/PROMPTS_IA.md": "# Prompts de IA\n\n## Avaliar oferta\n\nVocê é um especialista em ofertas e afiliados. Avalie se o produto abaixo vale ser divulgado.\n\nCampos:\n- Produto\n- Preço atual\n- Preço anterior\n- Categoria\n- Cupom\n- Avaliação\n- Comissão\n\nRetorne:\n- Nota de 0 a 10\n- Motivos\n- Melhor canal\n- Melhor texto curto\n\n## Gerar mensagem\n\nCrie versões para Telegram, Instagram e WhatsApp.\nUse linguagem popular, direta e confiável.\nInclua aviso de preço sujeito a alteração.\n",
  "tests/test_text_generator.py": "from app.core.models import Product, Channel\nfrom app.services.text_generator import generate_message\n\n\ndef test_generate_telegram_message():\n    p = Product(platform=\"Shopee\", name=\"Produto Teste\", original_url=\"https://example.com\", price=10)\n    msg = generate_message(p, Channel.telegram, \"https://example.com?sub_id=x\")\n    assert \"Produto Teste\" in msg\n    assert \"https://example.com\" in msg\n",
  "tests/__init__.py": "\"\"\"Package.\"\"\"\n",
  "app/core/config.py": "\"\"\"Configurações globais do sistema.\"\"\"\n\nfrom pydantic import Field\nfrom pydantic_settings import BaseSettings, SettingsConfigDict\n\n\nclass Settings(BaseSettings):\n    model_config = SettingsConfigDict(env_file=\".env\", env_file_encoding=\"utf-8\", extra=\"ignore\")\n\n    environment: str = Field(default=\"development\", alias=\"ENVIRONMENT\")\n    database_url: str = Field(default=\"sqlite:///./data/caca_oferta.sqlite3\", alias=\"DATABASE_URL\")\n\n    brand_name: str = Field(default=\"Caça Oferta Oficial\", alias=\"BRAND_NAME\")\n    default_affiliate_disclosure: str = Field(\n        default=\"Alguns links podem gerar comissão para o Caça Oferta Oficial, sem custo adicional para você.\",\n        alias=\"DEFAULT_AFFILIATE_DISCLOSURE\",\n    )\n\n    telegram_bot_token: str | None = Field(default=None, alias=\"TELEGRAM_BOT_TOKEN\")\n    telegram_channel_id: str | None = Field(default=None, alias=\"TELEGRAM_CHANNEL_ID\")\n    telegram_channel_name: str = Field(default=\"Caça Oferta Oficial\", alias=\"TELEGRAM_CHANNEL_NAME\")\n    telegram_channel_url: str = Field(default=\"https://t.me/caca_ofertaoficial\", alias=\"TELEGRAM_CHANNEL_URL\")\n\n    instagram_username: str = Field(default=\"caca.ofertaoficial\", alias=\"INSTAGRAM_USERNAME\")\n    instagram_access_token: str | None = Field(default=None, alias=\"INSTAGRAM_ACCESS_TOKEN\")\n    instagram_business_account_id: str | None = Field(default=None, alias=\"INSTAGRAM_BUSINESS_ACCOUNT_ID\")\n\n    whatsapp_token: str | None = Field(default=None, alias=\"WHATSAPP_TOKEN\")\n    whatsapp_phone_number_id: str | None = Field(default=None, alias=\"WHATSAPP_PHONE_NUMBER_ID\")\n\n    shopee_app_id: str | None = Field(default=None, alias=\"SHOPEE_APP_ID\")\n    shopee_app_secret: str | None = Field(default=None, alias=\"SHOPEE_APP_SECRET\")\n    shopee_affiliate_id: str | None = Field(default=None, alias=\"SHOPEE_AFFILIATE_ID\")\n\n\nsettings = Settings()\n",
  "app/core/database.py": "\"\"\"Banco de dados do Caça Oferta Oficial.\"\"\"\n\nfrom pathlib import Path\n\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import declarative_base, sessionmaker\n\nfrom app.core.config import settings\n\n\nif settings.database_url.startswith(\"sqlite\"):\n    Path(\"data\").mkdir(exist_ok=True)\n\nengine = create_engine(settings.database_url, echo=False, future=True)\nSessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False, future=True)\nBase = declarative_base()\n\n\ndef create_tables() -> None:\n    from app.core import models  # noqa: F401\n\n    Base.metadata.create_all(bind=engine)\n",
  "app/core/models.py": "\"\"\"Modelos de dados.\"\"\"\n\nfrom datetime import datetime\nfrom enum import Enum\n\nfrom sqlalchemy import Boolean, DateTime, Enum as SQLEnum, Float, ForeignKey, Integer, String, Text\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\n\nfrom app.core.database import Base\n\n\nclass Channel(str, Enum):\n    telegram = \"telegram\"\n    instagram = \"instagram\"\n    whatsapp = \"whatsapp\"\n\n\nclass OfferStatus(str, Enum):\n    pending = \"pending\"\n    approved = \"approved\"\n    posted = \"posted\"\n    rejected = \"rejected\"\n\n\nclass Product(Base):\n    __tablename__ = \"products\"\n\n    id: Mapped[int] = mapped_column(Integer, primary_key=True)\n    platform: Mapped[str] = mapped_column(String(50), index=True)\n    name: Mapped[str] = mapped_column(String(255), index=True)\n    category: Mapped[str | None] = mapped_column(String(120), nullable=True)\n    original_url: Mapped[str] = mapped_column(Text)\n    image_url: Mapped[str | None] = mapped_column(Text, nullable=True)\n    price: Mapped[float | None] = mapped_column(Float, nullable=True)\n    old_price: Mapped[float | None] = mapped_column(Float, nullable=True)\n    coupon: Mapped[str | None] = mapped_column(String(80), nullable=True)\n    rating: Mapped[float | None] = mapped_column(Float, nullable=True)\n    commission_rate: Mapped[float | None] = mapped_column(Float, nullable=True)\n    score: Mapped[float | None] = mapped_column(Float, nullable=True)\n    status: Mapped[OfferStatus] = mapped_column(SQLEnum(OfferStatus), default=OfferStatus.pending)\n    created_at: Mapped[datetime] = mapped_column(DateTime, default=datetime.utcnow)\n\n    links = relationship(\"AffiliateLink\", back_populates=\"product\")\n    posts = relationship(\"Post\", back_populates=\"product\")\n\n\nclass AffiliateLink(Base):\n    __tablename__ = \"affiliate_links\"\n\n    id: Mapped[int] = mapped_column(Integer, primary_key=True)\n    product_id: Mapped[int] = mapped_column(ForeignKey(\"products.id\"), index=True)\n    channel: Mapped[Channel] = mapped_column(SQLEnum(Channel), index=True)\n    url: Mapped[str] = mapped_column(Text)\n    sub_id: Mapped[str] = mapped_column(String(120), index=True)\n    clicks: Mapped[int] = mapped_column(Integer, default=0)\n    created_at: Mapped[datetime] = mapped_column(DateTime, default=datetime.utcnow)\n\n    product = relationship(\"Product\", back_populates=\"links\")\n    posts = relationship(\"Post\", back_populates=\"affiliate_link\")\n\n\nclass Post(Base):\n    __tablename__ = \"posts\"\n\n    id: Mapped[int] = mapped_column(Integer, primary_key=True)\n    product_id: Mapped[int] = mapped_column(ForeignKey(\"products.id\"), index=True)\n    affiliate_link_id: Mapped[int] = mapped_column(ForeignKey(\"affiliate_links.id\"), index=True)\n    channel: Mapped[Channel] = mapped_column(SQLEnum(Channel), index=True)\n    message: Mapped[str] = mapped_column(Text)\n    external_id: Mapped[str | None] = mapped_column(String(255), nullable=True)\n    posted: Mapped[bool] = mapped_column(Boolean, default=False)\n    created_at: Mapped[datetime] = mapped_column(DateTime, default=datetime.utcnow)\n    posted_at: Mapped[datetime | None] = mapped_column(DateTime, nullable=True)\n\n    product = relationship(\"Product\", back_populates=\"posts\")\n    affiliate_link = relationship(\"AffiliateLink\", back_populates=\"posts\")\n\n\nclass Sale(Base):\n    __tablename__ = \"sales\"\n\n    id: Mapped[int] = mapped_column(Integer, primary_key=True)\n    affiliate_link_id: Mapped[int] = mapped_column(ForeignKey(\"affiliate_links.id\"), index=True)\n    channel: Mapped[Channel] = mapped_column(SQLEnum(Channel), index=True)\n    order_id: Mapped[str | None] = mapped_column(String(120), nullable=True)\n    gross_value: Mapped[float | None] = mapped_column(Float, nullable=True)\n    commission: Mapped[float | None] = mapped_column(Float, nullable=True)\n    created_at: Mapped[datetime] = mapped_column(DateTime, default=datetime.utcnow)\n",
  "app/core/security.py": "\"\"\"Funções de segurança.\"\"\"\n\nimport os\nimport secrets\n\n\ndef get_required_env(name: str) -> str:\n    value = os.getenv(name)\n    if not value:\n        raise RuntimeError(f\"Variável obrigatória ausente: {name}\")\n    return value\n\n\ndef generate_tracking_token(prefix: str) -> str:\n    return f\"{prefix}_{secrets.token_hex(6)}\"\n",
  "app/core/__init__.py": "\"\"\"Package.\"\"\"\n",
  "app/services/text_generator.py": "\"\"\"Geração de mensagens por canal.\"\"\"\n\nfrom app.core.config import settings\nfrom app.core.models import Product, Channel\n\n\ndef _money(value: float | None) -> str:\n    if value is None:\n        return \"Consulte o preço\"\n    return f\"R$ {value:,.2f}\".replace(\",\", \"X\").replace(\".\", \",\").replace(\"X\", \".\")\n\n\ndef benefits_for(product: Product) -> list[str]:\n    benefits = []\n    if product.old_price and product.price and product.old_price > product.price:\n        benefits.append(\"Preço abaixo do valor anterior\")\n    if product.rating and product.rating >= 4.5:\n        benefits.append(\"Produto bem avaliado\")\n    if product.coupon:\n        benefits.append(\"Tem cupom disponível\")\n    if product.category:\n        benefits.append(f\"Achadinho de {product.category}\")\n    return benefits or [\"Oferta selecionada\", \"Boa oportunidade para economizar\"]\n\n\ndef generate_message(product: Product, channel: Channel, url: str) -> str:\n    price = _money(product.price)\n    coupon = product.coupon or \"sem cupom informado\"\n    bullet_lines = \"\\n\".join(f\"✅ {item}\" for item in benefits_for(product))\n\n    if channel == Channel.telegram:\n        return (\n            f\"<b>🔥 BAIXOU!</b>\\n\\n\"\n            f\"<b>{product.name}</b>\\n\\n\"\n            f\"💰 {price}\\n\"\n            f\"🏬 {product.platform}\\n\\n\"\n            f\"{bullet_lines}\\n\\n\"\n            f\"🎟 Cupom: {coupon}\\n\\n\"\n            f\"🛒 Comprar aqui:\\n{url}\\n\\n\"\n            f\"⚠️ Preço e estoque podem mudar.\\n\"\n            f\"{settings.default_affiliate_disclosure}\"\n        )\n\n    if channel == Channel.instagram:\n        return (\n            f\"🔥 Achadinho encontrado!\\n\\n\"\n            f\"{product.name}\\n\"\n            f\"Por apenas {price}\\n\\n\"\n            f\"{bullet_lines}\\n\\n\"\n            f\"🎟 Cupom: {coupon}\\n\"\n            f\"Link na bio ou nos Stories.\\n\\n\"\n            f\"⚠️ Preço pode mudar.\\n\"\n            f\"{settings.default_affiliate_disclosure}\"\n        )\n\n    return (\n        f\"🚨 BAIXOU!\\n\\n\"\n        f\"{product.name}\\n\\n\"\n        f\"🔥 {price}\\n\"\n        f\"🏬 {product.platform}\\n\\n\"\n        f\"{bullet_lines}\\n\\n\"\n        f\"🛒 {url}\\n\"\n        f\"🎟 Cupom: {coupon}\\n\\n\"\n        f\"⚠️ Preço pode mudar a qualquer momento.\\n\"\n        f\"📢 Chama os amigos!\\n\\n\"\n        f\"{settings.default_affiliate_disclosure}\"\n    )\n\n\ndef generate_reels_script(product: Product) -> str:\n    return (\n        f\"Gancho: 'Olha esse achado que eu encontrei hoje!'\\n\"\n        f\"Meio: '{product.name} por {_money(product.price)}.'\\n\"\n        f\"Final: 'Corre no link da bio antes que acabe.'\"\n    )\n\n\ndef generate_carousel_text(product: Product) -> list[str]:\n    return [\n        \"Slide 1: 🔥 BAIXOU DEMAIS\",\n        f\"Slide 2: {product.name}\",\n        f\"Slide 3: {_money(product.price)}\",\n        \"Slide 4: Por que vale a pena: \" + \"; \".join(benefits_for(product)),\n        \"Slide 5: Link na bio ou nos Stories\",\n    ]\n",
  "app/services/ranking_service.py": "\"\"\"Pontuação de ofertas.\"\"\"\n\nfrom app.core.models import Product\n\n\ndef score_product(product: Product) -> float:\n    score = 0.0\n\n    if product.price:\n        score += 1.0\n\n    if product.old_price and product.price and product.old_price > product.price:\n        discount = (product.old_price - product.price) / product.old_price\n        score += min(discount * 10, 3.0)\n\n    if product.rating:\n        score += min(product.rating / 5 * 2, 2.0)\n\n    if product.coupon:\n        score += 1.0\n\n    if product.commission_rate:\n        score += min(product.commission_rate * 20, 2.0)\n\n    if product.category and product.category.lower() in {\"casa\", \"cozinha\", \"beleza\", \"tecnologia\", \"utilidades\"}:\n        score += 1.0\n\n    return round(min(score, 10.0), 2)\n",
  "app/services/link_service.py": "\"\"\"Geração de links de afiliado e subIds.\"\"\"\n\nfrom urllib.parse import urlencode, urlparse, parse_qs, urlunparse\n\nfrom app.core.models import Channel, Product\n\n\ndef slugify(text: str) -> str:\n    import re\n    import unicodedata\n\n    text = unicodedata.normalize(\"NFKD\", text).encode(\"ascii\", \"ignore\").decode(\"ascii\")\n    text = re.sub(r\"[^a-zA-Z0-9]+\", \"_\", text).strip(\"_\").lower()\n    return text[:40]\n\n\ndef make_sub_id(product: Product, channel: Channel) -> str:\n    return f\"{channel.value}_{slugify(product.name)}_{product.id or 'novo'}\"\n\n\ndef add_tracking_param(url: str, sub_id: str) -> str:\n    parsed = urlparse(url)\n    query = parse_qs(parsed.query)\n    query[\"sub_id\"] = [sub_id]\n    new_query = urlencode(query, doseq=True)\n    return urlunparse(parsed._replace(query=new_query))\n",
  "app/services/seed_service.py": "\"\"\"Dados de demonstração.\"\"\"\n\nfrom sqlalchemy.orm import Session\n\nfrom app.core.models import Product, OfferStatus\nfrom app.services.ranking_service import score_product\n\n\ndef seed_demo_data(session: Session) -> None:\n    if session.query(Product).count():\n        return\n\n    product = Product(\n        platform=\"Shopee\",\n        name=\"Organizador multiuso para cozinha\",\n        category=\"Casa e cozinha\",\n        original_url=\"https://shopee.com.br/produto-exemplo\",\n        image_url=\"https://via.placeholder.com/800x800.png?text=Caca+Oferta\",\n        price=29.90,\n        old_price=49.90,\n        coupon=\"OFERTA10\",\n        rating=4.8,\n        commission_rate=0.08,\n        status=OfferStatus.approved,\n    )\n    product.score = score_product(product)\n    session.add(product)\n    session.commit()\n",
  "app/services/__init__.py": "\"\"\"Package.\"\"\"\n",
  "app/channels/telegram.py": "\"\"\"Publicação no Telegram.\"\"\"\n\nimport logging\nimport requests\n\nfrom app.core.config import settings\n\nlogger = logging.getLogger(__name__)\n\n\nclass TelegramPublisher:\n    def __init__(self) -> None:\n        if not settings.telegram_bot_token or not settings.telegram_channel_id:\n            raise RuntimeError(\"Configure TELEGRAM_BOT_TOKEN e TELEGRAM_CHANNEL_ID no .env\")\n        self.token = settings.telegram_bot_token\n        self.channel_id = settings.telegram_channel_id\n\n    def send_message(self, text: str, parse_mode: str = \"HTML\") -> dict:\n        url = f\"https://api.telegram.org/bot{self.token}/sendMessage\"\n        payload = {\n            \"chat_id\": self.channel_id,\n            \"text\": text,\n            \"parse_mode\": parse_mode,\n            \"disable_web_page_preview\": False,\n        }\n        response = requests.post(url, json=payload, timeout=20)\n        response.raise_for_status()\n        return response.json()\n",
  "app/channels/instagram.py": "\"\"\"Instagram Graph API.\n\nNo MVP, este módulo gera conteúdos para publicação manual.\nNa fase automática, use create_media + publish_media.\n\"\"\"\n\nimport requests\n\nfrom app.core.config import settings\n\n\nclass InstagramPublisher:\n    def create_media(self, image_url: str, caption: str) -> str:\n        if not settings.instagram_access_token or not settings.instagram_business_account_id:\n            raise RuntimeError(\"Credenciais do Instagram não configuradas.\")\n\n        url = f\"https://graph.facebook.com/v19.0/{settings.instagram_business_account_id}/media\"\n        payload = {\n            \"image_url\": image_url,\n            \"caption\": caption,\n            \"access_token\": settings.instagram_access_token,\n        }\n        response = requests.post(url, data=payload, timeout=30)\n        response.raise_for_status()\n        return response.json()[\"id\"]\n\n    def publish_media(self, creation_id: str) -> dict:\n        url = f\"https://graph.facebook.com/v19.0/{settings.instagram_business_account_id}/media_publish\"\n        payload = {\n            \"creation_id\": creation_id,\n            \"access_token\": settings.instagram_access_token,\n        }\n        response = requests.post(url, data=payload, timeout=30)\n        response.raise_for_status()\n        return response.json()\n",
  "app/channels/whatsapp.py": "\"\"\"WhatsApp.\n\nNo MVP, gera texto pronto para copiar e colar.\nNo futuro, envia via WhatsApp Cloud API com templates aprovados.\n\"\"\"\n\nimport requests\n\nfrom app.core.config import settings\n\n\nclass WhatsAppPublisher:\n    def send_template(self, to_number: str, template_name: str, parameters: list[str]) -> dict:\n        if not settings.whatsapp_token or not settings.whatsapp_phone_number_id:\n            raise RuntimeError(\"Credenciais do WhatsApp não configuradas.\")\n\n        url = f\"https://graph.facebook.com/v19.0/{settings.whatsapp_phone_number_id}/messages\"\n        headers = {\"Authorization\": f\"Bearer {settings.whatsapp_token}\"}\n        payload = {\n            \"messaging_product\": \"whatsapp\",\n            \"to\": to_number,\n            \"type\": \"template\",\n            \"template\": {\n                \"name\": template_name,\n                \"language\": {\"code\": \"pt_BR\"},\n                \"components\": [\n                    {\n                        \"type\": \"body\",\n                        \"parameters\": [{\"type\": \"text\", \"text\": value} for value in parameters],\n                    }\n                ],\n            },\n        }\n        response = requests.post(url, json=payload, headers=headers, timeout=30)\n        response.raise_for_status()\n        return response.json()\n",
